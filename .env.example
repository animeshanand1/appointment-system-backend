NODE_ENV=development
PORT=5000
APP_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/appointment-sys
JWT_SECRET=change-this-to-a-long-random-string
# Optional legacy shared code. Prefer per-doctor codes from the admin dashboard.
DOCTOR_INVITE_CODE=change-this-invite-code
# Email delivery. Leave SMTP_URL empty in development to log emails instead.
SMTP_URL=
MAIL_FROM="Dr Sahayak <no-reply@example.com>"
# Reverse proxies in front of the API (0 if none). Needed for correct rate limiting.
TRUST_PROXY=0
